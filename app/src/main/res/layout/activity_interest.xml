<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".InterestActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:text="@string/back"
            android:textColor="@color/primary"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="@string/formula_interest_title"
            android:textColor="@color/text_primary"
            android:textSize="27sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:text="@string/interest_introduction"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Dos imágenes para capital final e interés ganado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/interest_formula_heading"
                android:textColor="@color/primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/interest_final_formula_label"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="102dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_formula_panel"
                android:contentDescription="@string/interest_final_formula_accessibility"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/interest_final_formula" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/interest_earned_formula_label"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="102dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_formula_panel"
                android:contentDescription="@string/interest_earned_formula_accessibility"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/interest_earned_formula" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:text="@string/interest_formula_explanation"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- tres inputs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/inputs"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:labelFor="@id/etCapital"
                android:text="@string/interest_capital_label"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etCapital"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_formula_panel"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:hint="@string/interest_capital_hint"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal|numberSigned"
                android:maxLength="15"
                android:minHeight="54dp"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:labelFor="@id/etRate"
                android:text="@string/interest_rate_label"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_formula_panel"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:hint="@string/interest_rate_hint"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal|numberSigned"
                android:maxLength="10"
                android:minHeight="54dp"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:labelFor="@id/etPeriods"
                android:text="@string/interest_periods_label"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etPeriods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_formula_panel"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:hint="@string/interest_periods_hint"
                android:imeOptions="actionDone"
                android:inputType="numberSigned"
                android:maxLength="4"
                android:minHeight="54dp"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:text="@string/interest_input_help"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/button_state_colors"
                android:enabled="false"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:minHeight="52dp"
                android:text="@string/calculate"
                android:textColor="@color/button_text_state_colors"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:text="@string/clear"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/result"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvFinalCapitalResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:textColor="@color/primary"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/tvInterestResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:textColor="@color/secondary"
                android:textSize="23sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
