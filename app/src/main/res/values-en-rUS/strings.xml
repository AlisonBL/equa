    <string name="ohm_introduction">Calculate electric current from voltage and resistance.</string>
    <string name="ohm_formula_heading">OHMS LAW FORMULA</string>
    <string name="ohm_formula_accessibility">Current equals voltage divided by resistance.</string>
    <string name="ohm_formula_explanation">I = current in amperes; V = voltage in volts; R = resistance in ohms.</string>
    <string name="ohm_voltage_label">Voltage (V)</string>
